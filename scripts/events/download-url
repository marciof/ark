# TODO re-add fallback to `youwee://` protocol?
# TODO re-add fallback to `shell:AppsFolder`?
locate_youwee_in_wsl() {
    # Check Package Management first, and only then resort to a registry query.
    # https://learn.microsoft.com/powershell/module/packagemanagement/get-package
    #
    # If Youwee is initially installed via an MSI installer and later updated,
    # then it will be relocated/re-installed to the user's `%APPDATA%`,
    # which `Get-Package` won't be able to locate.
    # TODO put fastest first? check HKLM too?
    { {
        powershell.exe -NonInteractive '(Get-Package -Name Youwee).Source' \
        | tr -d '\r' \
        | grep .
    } \
    || {
        reg.exe query 'HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Youwee' \
        | grep InstallLocation \
        | tr -d '\r' \
        | grep -oP '[^\s"]*\\[^"]+'
    } } \
    | xargs -d '\n' wslpath
}

run_youwee_via_wsl() {
    # TODO failing to run `ffmpeg` under Windows when Dropbox is running?
    "$(locate_youwee_in_wsl)/youwee.exe" "$@"
}

in_wsl() {
    command -v wslpath >/dev/null
}

run_youwee() {
    # TODO maybe check if `youwee[.exe]` is in $PATH first?
    if in_wsl; then
        run_youwee_via_wsl "$@"
    else
        youwee "$@"
    fi
}

